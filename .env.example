# API (services/api)
PORT=8788
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
DATABASE_URL=postgresql://sss:sss@127.0.0.1:5433/sss
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# App allowlist, id:label pairs
APPS=klinik:Portal Klinik,market:Pasar Digital

# Sessions and challenges
CHALLENGE_TTL_SECONDS=120
SESSION_TTL_SECONDS=900

# Simulated guardians seeded on first boot
GUARDIAN_COUNT=5

# Relayed transactions per IP per hour (relayer pays gas)
RELAY_QUOTA_PER_HOUR=10

# Optional: restrict browser origin (defaults to permissive for local dev)
# CORS_ORIGIN=http://127.0.0.1:5173

# Optional: point the dev server at a different API
# VITE_API_TARGET=http://127.0.0.1:8788
